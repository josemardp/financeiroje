# ============================================================
# FinanceiroJe — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione .env — está no .gitignore.
# Valores encontrados em: https://app.supabase.com → projeto → Settings → API
# ============================================================

# Frontend (Vite expõe variáveis VITE_* ao browser)
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon_key_aqui
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Usadas por scripts/edge functions locais (não vão ao frontend)
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon_key_aqui
